{
  "manifest_version": 3,
  "name": "Twitch Streak Saver",
  "version": "0.3.18",
  "key": "",
  "description": "Open Twitch channels, apply preferred video quality and per-channel audio preferences, and report stream availability to the app.",
  "permissions": ["alarms", "nativeMessaging", "storage", "tabs"],
  "host_permissions": ["https://www.twitch.tv/*", "https://player.twitch.tv/*"],
  "action": {
    "default_title": "Wake browser connection",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*", "https://player.twitch.tv/*"],
      "js": ["twitch_tabs.js", "quality.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}